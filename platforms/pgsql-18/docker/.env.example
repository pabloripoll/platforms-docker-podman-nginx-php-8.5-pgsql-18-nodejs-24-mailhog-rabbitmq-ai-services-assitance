# IF GNU MAKE IS INSTALLED - IT IS NOT REQUIRED TO UPDATE THIS ENVIRONMENT FILE
# REMOVE COMMENTS WHEN COPY THIS FILE AND TRIM TRAILING WHITESPACES
# Ask the team for recommended values

COMPOSE_LEAD=myproj                                 # <- lead abbreviation or acronym as part of related containers naming rule -------------------------> #
COMPOSE_CNET=mp-dev                                 # <- useful for networking to connect between containers --------------------------------------------> #
COMPOSE_IMGK=alpine-3.24-pgsql-18                   # <- real main image keys to manage automations for sharing resources -------------------------------> #
COMPOSE_NAME=mp-pgsql-dev                           # <- container name to build the service - it is important to set the environment in this variable --> #
COMPOSE_HOST=127.0.0.1                              # <- machine hostname referrer - not necessary for this project -------------------------------------> #
COMPOSE_PORT=7710                                   # <- local machine port opened for container service ------------------------------------------------> #
COMPOSE_CPUS=2.00                                   # <- container's maximum CPUs usage to apply by docker-compose - leave it empty for full usage ------> #
COMPOSE_MEMO=128M                                   # <- container's maximum RAM usage to apply by docker-compose ---------------------------------------> #
COMPOSE_SWAP=256M                                   # <- container's RAM swap space in storage executed by automation command ---------------------------> #
COMPOSE_DATA="./data"                               # <- platform data storage in local -----------------------------------------------------------------> #
COMPOSE_LOGS="./logs"                               # <- platform logs storage in local -----------------------------------------------------------------> #
POSTGRES_ROOT_PASSWORD="root-strong-password"       # <- database root password -------------------------------------------------------------------------> #
POSTGRES_DATABASE=local_dev                         # <- database name ----------------------------------------------------------------------------------> #
POSTGRES_USER=user_dev                              # <- database user ----------------------------------------------------------------------------------> #
POSTGRES_PASSWORD="password-dev"                    # <- database password ------------------------------------------------------------------------------> #