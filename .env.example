# REMOVE COMMENTS WHEN COPY THIS FILE AND TRIM TRAILING WHITESPACES
# Ask the team for recommended values

# ENGINE DEFINITION (docker or podman) - VARIABLES FOR AUTOMATE CONTAINER SERVICES
SUDO=sudo                                               # <- user priviledge for running engine commands, left blank if user runs it without sudo -----------> #
ENGINE=docker                                           # <- must define container engine system ------------------------------------------------------------> #
ENGINE_COMMAND=$(SUDO) $(ENGINE)                        # <- engine core command generator ------------------------------------------------------------------> #
ENGINE_COMPOSE=$(SUDO) $(ENGINE) compose                # <- targets "docker compose" / "docker-compose" or "podman compose" --------------------------------> #

# CONTAINERS BASE INFORMATION FOR BUILDING WITH docker-compose.yml
SERVICE_NAME="PLATFORMS DOCKER"                         # <- this variable will be served for automation terminal outputs -----------------------------------> #
SERVICE_LEAD=myproj                                     # <- lead abbreviation or acronym as part of the related containers naming rule ---------------------> #
SERVICE_SLUG=dev                                        # <- instance/branch identifier (e.g., dev_a, dev_b) as part of the related containers naming rule --> #
SERVICE_CNET=$(SERVICE_LEAD)-net-$(SERVICE_SLUG)        # <- network vairiable for container connections between each other when is required ----------------> #
SERVICE_HOST=127.0.0.1                                  # <- host machine loopback address for isolated networks --------------------------------------------> #

# APP
WEB_PLTF=nginx-nodejs-24                                # <- platform assets directory's name ---------------------------------------------------------------> #
WEB_IMGK=alpine-3.24-nginx-nodejs-24                    # <- real main image keys to manage automations for sharing resources -------------------------------> #
WEB_PORT=7710                                           # <- local machine port opened for container service ------------------------------------------------> #
WEB_BIND="../../../services/application"                # <- path where application is binded from container to local ---------------------------------------> #
WEB_CAAS=$(SERVICE_LEAD)-app-$(SERVICE_SLUG)            # <- container name to build the service - it is important to set the environment in this variable --> #
WEB_CPUS=2.00                                           # <- container's maximum CPUs usage to apply by docker-compose - leave it empty for full usage ------> #
WEB_MEMO=256M                                           # <- container's maximum RAM usage to apply by docker-compose ---------------------------------------> #
WEB_SWAP=512M                                           # <- container's RAM swap space in storage executed by automation command ---------------------------> #
WEB_USER=osuser                                         # <- container's project directory user -------------------------------------------------------------> #
WEB_GROUP=osgroup                                       # <- container's project directory group ------------------------------------------------------------> #

# API
API_PLTF=nginx-php-8.5                                  # <- platform assets directory's name ---------------------------------------------------------------> #
API_IMGK=alpine-3.24-nginx-php-8.5                      # <- real main image keys to manage automations for sharing resources -------------------------------> #
API_PORT=7711                                           # <- local machine port opened for container service ------------------------------------------------> #
API_BIND="../../../services/api-rest"                   # <- path where application is binded from container to local ---------------------------------------> #
API_CAAS=$(SERVICE_LEAD)-api-$(SERVICE_SLUG)            # <- container name to build the service - it is important to set the environment in this variable --> #
API_CPUS=2.00                                           # <- container's maximum CPUs usage to apply by docker-compose - leave it empty for full usage ------> #
API_MEMO=128M                                           # <- container's maximum RAM usage to apply by docker-compose ---------------------------------------> #
API_SWAP=256M                                           # <- container's RAM swap space in storage executed by automation command ---------------------------> #
API_USER=osuser                                         # <- container's project directory user -------------------------------------------------------------> #
API_GROUP=osgroup                                       # <- container's project directory group ------------------------------------------------------------> #

# DATABASE
DATABASE_PLTF=pgsql-18                                  # <- platform assets directory's name ---------------------------------------------------------------> #
DATABASE_IMGK=alpine-3.24-pgsql-18                      # <- real main image keys to manage automations for sharing resources -------------------------------> #
DATABASE_PORT=7712                                      # <- local machine port opened for container service ------------------------------------------------> #
DATABASE_CAAS=$(SERVICE_LEAD)-pgsql-$(SERVICE_SLUG)     # <- container name to build the service - it is important to set the environment in this variable --> #
DATABASE_CPUS=2.00                                      # <- container's maximum CPUs usage to apply by docker-compose - leave it empty for full usage ------> #
DATABASE_MEMO=128M                                      # <- container's maximum RAM usage to apply by docker-compose ---------------------------------------> #
DATABASE_SWAP=256M                                      # <- container's RAM swap space in storage executed by automation command ---------------------------> #
DATABASE_ROOT="root-strong-password"                    # <- database root password -------------------------------------------------------------------------> #
DATABASE_NAME=local_dev                                 # <- database name ----------------------------------------------------------------------------------> #
DATABASE_USER=user_dev                                  # <- database user ----------------------------------------------------------------------------------> #
DATABASE_PASS="password-$(SERVICE_SLUG)"                # <- database password ------------------------------------------------------------------------------> #
DATABASE_PATH="../../resources/database/"               # <- sql file's directory ---------------------------------------------------------------------------> #
DATABASE_INIT=pgsql-init.sql                            # <- init sql file ----------------------------------------------------------------------------------> #
DATABASE_BACK=pgsql-backup.sql                          # <- backup sql file --------------------------------------------------------------------------------> #
DATABASE_DATA="./data"                                  # <- platform data storage in local -----------------------------------------------------------------> #
DATABASE_LOGS="./logs"                                  # <- platform logs storage in local -----------------------------------------------------------------> #

# MAILER
MAILER_PLTF=mailhog-1                                   # <- platform assets directory's name ---------------------------------------------------------------> #
MAILER_IMGK=alpine-3.12-mailhog-1.0                     # <- real main image keys to manage automations for sharing resources -------------------------------> #
MAILER_PORT=7713                                        # <- local machine port opened for container service ------------------------------------------------> #
MAILER_DATA="./data"                                    # <- platform data storage in local -----------------------------------------------------------------> #
MAILER_LOGS="./logs"                                    # <- platform logs storage in local -----------------------------------------------------------------> #
MAILER_CAAS=$(SERVICE_LEAD)-mailhog-$(SERVICE_SLUG)     # <- container name to build the service - it is important to set the environment in this variable --> #
MAILER_CPUS=2.00                                        # <- container's maximum CPUs usage to apply by docker-compose - leave it empty for full usage ------> #
MAILER_MEMO=128M                                        # <- container's maximum RAM usage to apply by docker-compose ---------------------------------------> #
MAILER_SWAP=256M                                        # <- container's RAM swap space in storage executed by automation command ---------------------------> #
MAILER_APP_PORT=7714                                    # <- application ui management port -----------------------------------------------------------------> #

# BROKER
BROKER_PLTF=rabbitmq-4                                  # <- platform assets directory's name ---------------------------------------------------------------> #
BROKER_IMGK=rabbitmq:4-management-alpine                # <- real main image keys to manage automations for sharing resources -------------------------------> #
BROKER_PORT=7715                                        # <- local machine port opened for container service ------------------------------------------------> #
BROKER_DATA="./data"                                    # <- platform data storage in local -----------------------------------------------------------------> #
BROKER_LOGS="./logs"                                    # <- platform logs storage in local -----------------------------------------------------------------> #
BROKER_CAAS=$(SERVICE_LEAD)-rabbitmq-$(SERVICE_SLUG)    # <- container name to build the service - it is important to set the environment in this variable --> #
BROKER_CPUS=2.00                                        # <- container's maximum CPUs usage to apply by docker-compose - leave it empty for full usage ------> #
BROKER_MEMO=128M                                        # <- container's maximum RAM usage to apply by docker-compose ---------------------------------------> #
BROKER_SWAP=256M                                        # <- container's RAM swap space in storage executed by automation command ---------------------------> #
BROKER_APP_PORT=7716                                    # <- application ui management port -----------------------------------------------------------------> #
BROKER_APP_USER=guest                                   # <- application ui management user -----------------------------------------------------------------> #
BROKER_APP_PASS="guest"                                 # <- application ui management password -------------------------------------------------------------> #
BROKER_APP_COOKIE="guest-password"                      # <- application security ---------------------------------------------------------------------------> #
BROKER_APP_NODENAME="rabbit@rabbitmq"                   # <- application configuration ----------------------------------------------------------------------> #
